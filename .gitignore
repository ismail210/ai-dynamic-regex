# =========================
# Local-only training data (keep on disk, do not push)
# =========================
backend/training/datasets/
backend/training/engineering_artifacts/
backend/training/takeoff_exports/
backend/training/pdf/
backend/training/pdfs/
backend/training/excel/
backend/training/excels/

# Torch / system binaries never belong in git
*.dylib
*.pth

# Ignore generic weight dumps, but keep the three small neural artifacts
# that the multimodal pipeline loads at runtime (<1 MB each).
*.pt
!backend/training/graphsage_model.pt
!backend/training/multimodal_fusion.pt
