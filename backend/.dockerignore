# Build context for backend/Dockerfile. The runtime image copies only app.py,
# config.py, routers/, services/, database/ and training/; the test stage copies
# the rest of the context. Everything below stays out of every image.

# Local environments, caches, secrets
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
catboost_info/
.env
.env.*
*.pem
*.key
.DS_Store

# Uploaded drawings and per-document runtime state (private; lives on the data volume)
uploads/
training/documents/
training/engineering_artifacts/
training/takeoff_exports/
training/legend_profiles/
training/pdf/
training/excel/

# Evaluation snapshots the application never reads
training/eval_cache_backups/
