APP_ENV=production
HTTP_PORT=80
WEB_CONCURRENCY=1
LOG_LEVEL=info
CORS_ALLOW_ORIGINS=https://takeoff.example.com
MAX_UPLOAD_BYTES=104857600
UPLOAD_ANALYSIS_TIMEOUT_SECONDS=900
# Regenerable analysis caches. Cap documents retained and refuse writes when
# free space falls below this floor so a dense drawing set cannot fill the disk.
ARTIFACT_RETENTION_DOCUMENTS=5
ARTIFACT_MIN_FREE_BYTES=2147483648

# ---- Experimental ML flags (defaults OFF except learned fusion) ------------
# See: backend/scripts/feature_flags_status.py
#
# Damaged-label ranker — shadow logs during analyze without changing sections:
# ML_LABEL_RANKER_SHADOW=false
# Promote learned ordering into analyze only after shadow wins on gold:
# ML_LABEL_RANKER_ENABLED=false
#
# Association dataset builders / review kits (not live prediction):
# ML_ASSOCIATION_DATASET_ENABLED=false
#
# Live multimodal fusion checkpoint override (default on):
# LEARNED_FUSION_ENABLED=true
#
# Model governance (EXPERIMENTAL | APPROVED | DISABLED):
# MODEL_STATE_GEOMETRY=APPROVED
# MODEL_STATE_GRAPH=APPROVED
# MODEL_STATE_FUSION=APPROVED
# MODEL_STATE_LABEL_RANKER=EXPERIMENTAL
#
# spatial_index.py is experimental and not controlled by an env flag; it is
# not wired into live analyze / graph_builder (association datasets only).
