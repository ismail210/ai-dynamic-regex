# Estima3D container configuration. Copy to .env (never commit .env) and set
# real values there. docker-compose.yml reads only the variables below;
# docs/DOCKER.md explains each step.

# ---- Required -----------------------------------------------------------------
# Access key for every /api request (the browser asks for it once per tab).
# Generate a long random value, e.g. in PowerShell:
#   -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 40 | % {[char]$_})
API_ACCESS_TOKEN=replace-with-a-long-random-value

# ---- Web -----------------------------------------------------------------------
# The app is published on 127.0.0.1:<HTTP_PORT> only (a reverse proxy adds HTTPS).
HTTP_PORT=8080
# Exact origins allowed to call the API from another site. Empty: same-origin
# only (the bundled web app needs nothing here).
CORS_ALLOW_ORIGINS=

# Data volume (uploads + training state). Change only to run a restored copy.
ESTIMA3D_DATA_VOLUME=estima3d_data

# ---- Backend limits ------------------------------------------------------------
LOG_LEVEL=info
MAX_UPLOAD_BYTES=209715200
UPLOAD_ANALYSIS_TIMEOUT_SECONDS=1800
# Container memory ceiling. Extraction of a 26-page set peaks well below 2 GB;
# analysis of a 24-page set was measured at ~1.6 GB.
BACKEND_MEMORY_LIMIT=3g
# Regenerable analysis caches: documents retained and the free-space floor.
ARTIFACT_RETENTION_DOCUMENTS=3
ARTIFACT_MIN_FREE_BYTES=419430400

# ---- Optional LLM (off by default; the deterministic summary always runs) ------
DRAWING_SUMMARY_LLM_ENABLED=false
LEGEND_PROFILE_LLM_ENABLED=false
# The bundled Ollama service (docker compose --profile ollama up -d):
OLLAMA_BASE_URL=http://ollama:11434
# Or an Ollama already running on the Docker host (verify from the container,
# see docs/DOCKER.md): OLLAMA_BASE_URL=http://host.docker.internal:11434
LEGEND_LLM_MODEL=llama3.1:8b
OLLAMA_MEMORY_LIMIT=8g

# ---- Tests (docker compose --profile test run --rm backend-tests) -------------
# Folder holding the real reference drawings; reference tests skip without it.
# TESTING_PROJECTS_DIR=C:\path\to\Testing Projects

# Experimental ML flags (ML_LABEL_RANKER_*, LEARNED_FUSION_ENABLED, MODEL_STATE_*)
# keep their code defaults in containers; docker-compose.yml does not pass them.
