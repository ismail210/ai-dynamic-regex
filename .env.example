APP_ENV=production
HTTP_PORT=80
WEB_CONCURRENCY=1
LOG_LEVEL=info
CORS_ALLOW_ORIGINS=https://takeoff.example.com
MAX_UPLOAD_BYTES=104857600
UPLOAD_ANALYSIS_TIMEOUT_SECONDS=900
# Regenerable analysis caches. Cap documents retained and refuse writes when
# free space falls below this floor so a dense drawing set cannot fill the disk.
ARTIFACT_RETENTION_DOCUMENTS=5
ARTIFACT_MIN_FREE_BYTES=2147483648
